<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login | One Connect Portal</title>
    <link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="/admin.css" rel="stylesheet">
</head>
<body>
    <div class="auth-split">
        <!-- Left: brand panel -->
        <div class="auth-brandside">
            <div class="auth-brand">United In One Global Foundation</div>
            <div class="auth-brand-copy">
                <h1>One Connect Portal</h1>
                <p>Building Hope<br>Changing Lives</p>
            </div>
        </div>

        <!-- Right: login card -->
        <div class="auth-formside">
            <div class="auth-card">
                <h2>Login to your account</h2>

                <% if (error) { %>
                    <div class="login-error"><%= error %></div>
                <% } %>

                <form method="POST" action="/login">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email" placeholder="admin@example.com" required autofocus>

                    <div class="auth-label-row">
                        <label for="password">Password</label>
                        <span class="auth-forgot">Forgot ?</span>
                    </div>
                    <input type="password" id="password" name="password" placeholder="Enter your password" required>

                    <button type="submit">Login now</button>
                </form>

              
            </div>
        </div>
    </div>
</body>
</html>
