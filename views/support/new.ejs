<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>New Support Request | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <div class="admin-topbar"><div><a href="/support" class="back-link">&larr; Back to requests</a><h2>New Support Request</h2><div class="greeting-sub">Log a request received by email or phone.</div></div></div>
        <% if (error) { %><div class="banner banner-err"><%= error %></div><% } %>
        <form method="POST" action="/support/new" enctype="multipart/form-data" class="fc-form">
            <% groups.forEach(function(g){ %>
            <div class="panel"><h3 class="panel-title"><%= g.group %></h3>
                <div class="fc-grid"><% g.fields.forEach(function(f){ %><%- include('../partials/field-input', { f: f }) %><% }); %></div>
            </div>
            <% }); %>
            <div class="panel"><h3 class="panel-title">Case Management</h3>
                <div class="fc-grid">
                    <div class="fc-field"><label>Status</label><select name="work_status"><% WORK_STATUSES.forEach(function(s){ %><option value="<%= s %>"><%= WORK_LABEL[s] %></option><% }); %></select></div>
                    <div class="fc-field"><label>Assign to Field Partner</label><select name="assigned_to"><option value="">— Unassigned —</option><% partners.forEach(function(p){ %><option value="<%= p.name %>"><%= p.name %></option><% }); %><option value="Other">Other</option></select></div>
                </div>
            </div>
            <div class="panel"><h3 class="panel-title">Attachments <span class="panel-hint">optional</span></h3><input type="file" name="documents" multiple class="fc-file"></div>
            <div class="fc-actions"><a href="/support" class="btn-ghost">Cancel</a><button type="submit" class="btn-primary">Create Request</button></div>
        </form>
    </main>
</div>
</body></html>
