<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Field Partners | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <div class="admin-topbar"><div><a href="/support" class="back-link">&larr; Back to requests</a><h2>Field Partners</h2><div class="greeting-sub">Names you can assign support requests to.</div></div></div>
        <% if (notice) { %><div class="banner banner-ok"><%= notice %></div><% } %>
        <div class="panel">
            <h3 class="panel-title">Add a field partner</h3>
            <form method="POST" action="/support/partners/add" class="assign-form">
                <div class="fc-field" style="flex:1;"><label>Name</label><input type="text" name="name" placeholder="e.g. Tanzania Field Partner" required></div>
                <div class="fc-field field-submit"><button type="submit" class="btn-primary">Add</button></div>
            </form>
        </div>
        <div class="submissions-table">
            <div class="table-head"><div><h3>All field partners</h3><div class="table-sub"><%= partners.length %> total</div></div></div>
            <table><thead><tr><th>Name</th><th>Status</th><th>Actions</th></tr></thead><tbody>
            <% partners.forEach(function(p){ %>
                <tr>
                    <td><form method="POST" action="/support/partners/<%= p.id %>/rename" class="inline-form"><input type="text" name="name" value="<%= p.name %>" class="rename-input" onblur="this.form.submit()"></form></td>
                    <td><span class="badge badge-status-<%= (p.active!==false)?'reviewed':'archived' %>"><%= (p.active!==false)?'active':'inactive' %></span></td>
                    <td class="row-actions">
                        <form method="POST" action="/support/partners/<%= p.id %>/toggle" class="inline-form"><button class="btn-ghost"><%= (p.active!==false)?'Deactivate':'Activate' %></button></form>
                        <form method="POST" action="/support/partners/<%= p.id %>/remove" class="inline-form"><button class="btn-ghost btn-danger">Remove</button></form>
                    </td>
                </tr>
            <% }); %>
            </tbody></table>
        </div>
    </main>
</div>
</body></html>
