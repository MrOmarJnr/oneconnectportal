<%
    function val(v){ if(v===undefined||v===null||v==='') return '—'; if(Array.isArray(v)) return v.length?v.join(', '):'—'; return String(v); }
%>
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= sub.display_name %> | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <a href="/business" class="back-link">&larr; Back to business partners</a>
        <div class="detail-header">
            <div class="detail-title">
                <span class="badge badge-biz-<%= status %>"><%= STATUS_LABEL[status] %></span>
                <span class="pill <%= (sub.data.source==='manual')?'pill-manual':'pill-web' %>" style="margin-left:6px;"><%= sub.data.source==='manual'?'Manual entry':'From website' %></span>
                <h2><%= sub.display_name %></h2>
                <p><%= sub.data.country || '' %><%= sub.data.partner_since ? ' · Partner since ' + sub.data.partner_since : '' %></p>
            </div>
            <% if (canManage) { %>
            <div class="detail-actions">
                <a href="/business/<%= sub.id %>/edit" class="btn-ghost">Edit</a>
            </div>
            <% } %>
        </div>
        <% if (notice) { %><div class="banner banner-ok"><%= notice %></div><% } %>

<% if (canManage) { %>
        <div class="mgmt-panel">
            <div class="mgmt-label">Partner Status</div>
            <form method="POST" action="/business/<%= sub.id %>/status" class="status-inline">
                <select name="status"><% STATUSES.forEach(function(s){ %><option value="<%= s %>" <%= status===s?'selected':'' %>><%= STATUS_LABEL[s] %></option><% }); %></select>
                <button type="submit" class="btn-primary">Update Status</button>
            </form>
        </div>
        <% } %>
        <div class="detail-doc">
            <% groups.forEach(function(g, gi){ %>
                <div class="doc-section <%= gi===0?'is-first':'' %>">
                    <h3><%= g.group %></h3>
                    <dl class="doc-rows">
                        <% g.fields.forEach(function(f){ var v=sub.data[f.key]; if(f.key==='donation_amount'&&v) v='$'+Number(v).toLocaleString(); %>
                            <div class="doc-row"><dt><%= f.label %></dt><dd><%= val(v) %></dd></div>
                        <% }); %>
                        <% if (g.group==='Partnership') { %><div class="doc-row"><dt>Support Type</dt><dd><%= val(sub.data.support_type) %></dd></div><% } %>
                    </dl>
                </div>
            <% }); %>

            <div class="doc-section is-last">
                <h3>Document Repository</h3>
                <% if (!files.length) { %><p class="no-files">No documents uploaded yet.</p><% } else { %>
                    <ul class="file-list-detail"><% files.forEach(function(fl){ %><li><div><a href="/business/files/<%= fl.id %>" target="_blank"><%= fl.original_name %></a><div class="file-meta"><%= Math.round(fl.size/1024) %> KB</div></div></li><% }); %></ul>
                <% } %>
                <% if (canManage) { %>
                    <form method="POST" action="/business/<%= sub.id %>/files" enctype="multipart/form-data" class="upload-inline">
                        <input type="file" name="documents" multiple class="fc-file" required>
                        <button type="submit" class="btn-primary">Upload documents</button>
                    </form>
                <% } %>
            </div>
        </div>
    </main>
</div>
</body></html>
