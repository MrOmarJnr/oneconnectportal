<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Volunteer Applications | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <div class="admin-topbar"><div><h2>Talent Management</h2><div class="greeting-sub">Volunteer applications submitted from the website.</div></div></div>
        <%- include('../partials/talent-tabs') %>

        <div class="submissions-table">
            <div class="table-head">
                <div><h3>Volunteer Applications</h3><div class="table-sub"><%= rows.length %> total</div></div>
                <form class="search-box" method="GET" action="/talent/applications">
                    <span class="search-ico"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg></span>
                    <input type="text" name="q" placeholder="Search applicant..." value="<%= q %>"><button type="submit">Search</button>
                </form>
            </div>
            <% if (rows.length === 0) { %>
                <div class="empty-state"><p>No volunteer applications yet.</p></div>
            <% } else { %>
                <table>
                    <thead><tr><th class="col-num">#</th><th>Applicant</th><th>Role Applied For</th><th>Email</th><th>Stage</th><th>CV / Files</th><th>Submitted</th></tr></thead>
                    <tbody>
                    <% rows.forEach(function(row, i){ var st = stageOf(row); %>
                        <tr class="row-link" onclick="window.location='/talent/applications/<%= row.id %>'">
                            <td class="col-num"><%= i + 1 %></td>
                            <td class="name-cell"><strong><%= row.display_name %></strong><span><%= row.data.location || '' %></span></td>
                            <td><%= row.data.opportunity || '—' %></td>
                            <td><%= row.data.email || '—' %></td>
                            <td><span class="badge badge-stage-<%= st %>"><%= STAGE_LABEL[st] %></span></td>
                            <td><% if (fileCountMap[row.id]) { %><span class="file-chip">&#128206; <%= fileCountMap[row.id] %></span><% } else { %><span class="file-chip">—</span><% } %></td>
                            <td><%= new Date(row.created_at).toLocaleDateString() %></td>
                        </tr>
                    <% }); %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </main>
</div>
</body></html>
