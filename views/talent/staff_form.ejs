<% var draftId = (typeof draftId!=='undefined') ? draftId : ''; %>
<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= mode==='edit'?'Edit':'New' %> Staff Profile | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <div class="admin-topbar"><div>
            <a href="<%= mode==='edit' ? '/talent/staff/'+id : '/talent/staff' %>" class="back-link">&larr; Back</a>
            <h2><%= mode==='edit'?'Edit Staff Profile':'New Staff Profile' %></h2>
        </div></div>
        <% if (error) { %><div class="banner banner-err"><%= error %></div><% } %>
        <form method="POST" action="<%= mode==='edit' ? '/talent/staff/'+id+'/edit' : '/talent/staff/new' %>" enctype="multipart/form-data" class="fc-form">
            <% if (mode==='new') { %><input type="hidden" name="_draftId" value="<%= draftId %>"><% } %>
            <% groups.forEach(function(g){ %>
            <div class="panel">
                <h3 class="panel-title"><%= g.group %><% if (g.sensitive) { %> <span class="panel-hint" style="color:#e5484d;">sensitive — not encrypted yet</span><% } %></h3>
                <div class="fc-grid"><% g.fields.forEach(function(f){ %><%- include('../partials/field-input', { f: f, data: data }) %><% }); %></div>
            </div>
            <% }); %>
            <div class="panel"><h3 class="panel-title">Photo &amp; Documents</h3>
                <div class="fc-grid">
                    <div class="fc-field"><label>Photo (for ID badge)</label><input type="file" name="photo" accept="image/*" class="fc-file"></div>
                    <div class="fc-field"><label>Documents / contracts</label><input type="file" name="documents" multiple class="fc-file"></div>
                </div>
            </div>
            <div class="fc-actions"><a href="<%= mode==='edit' ? '/talent/staff/'+id : '/talent/staff' %>" class="btn-ghost">Cancel</a><% if (mode==='new') { %><button type="submit" class="btn-ghost" formaction="/drafts/save?module=staff" formnovalidate>Save as Draft</button><% } %><button type="submit" class="btn-primary"><%= mode==='edit'?'Save Changes':'Create Profile' %></button></div>
        </form>
    </main>
</div>
</body></html>
