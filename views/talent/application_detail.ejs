<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= sub.display_name %> | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <a href="/talent/applications" class="back-link">&larr; Back to applications</a>
        <div class="detail-header">
            <div class="detail-title">
                <span class="badge badge-stage-<%= stage %>"><%= STAGE_LABEL[stage] %></span>
                <h2><%= sub.display_name %></h2>
                <p><%= sub.display_subtitle %> &middot; Applied <%= new Date(sub.created_at).toLocaleString() %></p>
            </div>
            <div class="detail-actions">
                <a href="/talent/volunteers/<%= sub.id %>" class="btn-ghost">Open in pipeline</a>
            </div>
        </div>

        <div class="detail-doc">
            <% sections.forEach(function(section, sIndex){ %>
                <div class="doc-section <%= sIndex===0?'is-first':'' %>">
                    <h3><%= section.title %></h3>
                    <dl class="doc-rows"><% section.rows.forEach(function(r){ %><div class="doc-row"><dt><%= r.label %></dt><dd><%= r.value %></dd></div><% }); %></dl>
                </div>
            <% }); %>

            <div class="doc-section">
                <h3>CV / Attachments</h3>
                <% if (!files.length) { %><p class="no-files">No file was attached to this application.</p><% } else { %>
                    <ul class="file-list-detail"><% files.forEach(function(fl){ %><li><div><a href="/talent/files/<%= fl.id %>" target="_blank"><%= fl.original_name %></a><div class="file-meta"><%= (fl.field_name==='cv'?'CV · ':'') %><%= Math.round(fl.size/1024) %> KB</div></div></li><% }); %></ul>
                <% } %>
            </div>

            <div class="doc-section is-last">
                <h3>Consent</h3>
                <ul class="consent-check-list"><% consent.forEach(function(c){ %><li><span class="tick <%= c.checked?'tick-yes':'tick-no' %>"><%= c.checked?'✓':'✕' %></span><%= c.label %></li><% }); %></ul>
            </div>
        </div>
    </main>
</div>
</body></html>
