<%
    var _name = (typeof adminName !== 'undefined' && adminName) ? adminName : (typeof currentUserName !== 'undefined' && currentUserName ? currentUserName : 'Admin');
    var _role = (typeof currentRole !== 'undefined' && currentRole) ? currentRole : 'admin';
    var _active = (typeof activeModule !== 'undefined' && activeModule) ? activeModule : null;
    var _photo = (typeof currentUserPhoto !== 'undefined' && currentUserPhoto) ? currentUserPhoto : null;
    var _initials = _name.trim().split(/\s+/).map(function(w){ return w[0]; }).join('').slice(0,2).toUpperCase();
    var _roleLabel = { admin: 'Administrator', field: 'Field User', viewer: 'Viewer' }[_role] || 'User';
    function _can(mod){ try { return canAccess(_role, mod); } catch (e) { return _role === 'admin'; } }
    var _titles = { dashboard:'Dashboard', field:'Create a Field Case', support:'Partnership Support', business:'Business Partners', talent:'Talent Management', reports:'Reporting', users:'Users & Access' };
    var _pageTitle = _titles[_active] || 'One Connect Portal';
    var _nav = [
        { mod: 'dashboard', href: '/dashboard', label: 'Dashboard',                icon: '<rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/>' },
        { mod: 'field',    href: '/field',    label: 'Create a Field Case',      icon: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="M8 2v4"/><path d="M16 2v4"/><path d="M3 10h18"/><path d="M12 14v4"/><path d="M10 16h4"/>' },
        { mod: 'support',  href: '/support',  label: 'Partnership Support',      icon: '<path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.6l-1-1a5.5 5.5 0 1 0-7.8 7.8l1 1L12 21l7.8-7.6 1-1a5.5 5.5 0 0 0 0-7.8z"/>' },
        { mod: 'business', href: '/business', label: 'Business Partners',        icon: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M8 7V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/>' },
        { mod: 'talent',   href: '/talent',   label: 'Talent Management',        icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/>' },
        { mod: 'reports',  href: '/reports',  label: 'Reporting',                icon: '<path d="M3 3v18h18"/><rect x="7" y="10" width="3" height="7"/><rect x="12" y="6" width="3" height="11"/><rect x="17" y="13" width="3" height="4"/>' },
        { mod: 'users',    href: '/users',    label: 'Users',                    icon: '<path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M19 8v6"/><path d="M22 11h-6"/>' }
    ];
%>
<aside class="admin-sidebar">
    <div class="sidebar-brand">
        <span class="brand-logo">
            <img src="/logo-png.png" alt="UIOGF" class="sidebar-logo-img" onerror="this.style.display='none';this.nextElementSibling.style.display='inline-flex';">
            <span class="logo-mark" style="display:none;"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 3a9 9 0 0 0 0 18"/><path d="M12 7v10"/></svg></span>
        </span>
        <span class="brand-name">One&nbsp;Connect<span>&nbsp;Portal</span></span>
    </div>

    <nav class="admin-nav">
        <% _nav.forEach(function(item){ if (_can(item.mod)) { %>
            <a href="<%= item.href %>" class="<%= _active === item.mod ? 'is-active' : '' %>">
                <span class="nav-ico"><svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><%- item.icon %></svg></span>
                <span class="nav-label"><%= item.label %></span>
            </a>
        <% } }); %>
    </nav>

    <div class="sidebar-tag">United In One Global Foundation</div>
</aside>

<!-- Fixed top header (page context + user menu) -->
<header class="app-topbar">
    <div class="app-topbar-title">
        <span class="app-eyebrow">One Connect Portal</span>
        <span class="app-title"><%= _pageTitle %></span>
    </div>
    <div class="user-menu" id="userMenu">
        <button type="button" class="user-chip" onclick="document.getElementById('userMenu').classList.toggle('open')">
            <span class="user-avatar"><% if (_photo) { %><img src="/me/avatar" alt=""><% } else { %><%= _initials %><% } %></span>
            <span class="user-meta"><strong><%= _name %></strong><span><%= _roleLabel %></span></span>
            <svg class="user-caret" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
        </button>
        <div class="user-dropdown">
            <div class="ud-head">
                <span class="user-avatar lg"><% if (_photo) { %><img src="/me/avatar" alt=""><% } else { %><%= _initials %><% } %></span>
                <div><strong><%= _name %></strong><span><%= _roleLabel %></span></div>
            </div>
            <form method="POST" action="/logout">
                <button type="submit" class="ud-signout"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><path d="M16 17l5-5-5-5"/><path d="M21 12H9"/></svg> Sign out</button>
            </form>
        </div>
    </div>
</header>
<script>document.addEventListener('click',function(e){var m=document.getElementById('userMenu');if(m&&!m.contains(e.target))m.classList.remove('open');});</script>
