<!DOCTYPE html>
<html lang="en"><head>
<meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reporting — Field Cases | One Connect Portal</title>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:wght@500;600;700&family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link href="/admin.css" rel="stylesheet"></head>
<body>
<div class="admin-shell">
    <%- include('../partials/sidebar') %>
    <main class="admin-main">
        <div class="admin-topbar"><div><h2>Reporting</h2><div class="greeting-sub">Field case activity.</div></div></div>
        <%- include('../partials/reports-tabs') %>
        <div class="report-grid">
            <div class="report-card"><h3>Cases by Program Type</h3><div class="chart-box"><canvas id="c_prog"></canvas></div></div>
            <div class="report-card"><h3>Cases by Country</h3><div class="chart-box"><canvas id="c_country"></canvas></div></div>
            <div class="report-card report-wide"><h3>Cases Submitted Over Time</h3><div class="chart-box"><canvas id="c_time"></canvas></div></div>
        </div>
        <div class="submissions-table" style="margin-top:22px;">
            <div class="table-head"><div><h3>Field Cases</h3><div class="table-sub"><%= R.field.list.length %> total</div></div></div>
            <table><thead><tr><th>Case</th><th>Partner</th><th>Program</th><th>Status</th><th>Date</th></tr></thead><tbody>
            <% if (!R.field.list.length) { %><tr><td colspan="5" class="no-files" style="padding:24px;">No field cases yet.</td></tr><% } %>
            <% R.field.list.forEach(function(r){ %><tr class="row-link" onclick="window.location='/field/cases/<%= r.id %>'"><td><strong><%= r.title %></strong></td><td><%= r.partner %></td><td><%= r.program %></td><td><span class="badge badge-status-<%= r.status %>"><%= r.status %></span></td><td><%= r.date %></td></tr><% }); %>
            </tbody></table>
        </div>
    </main>
</div>
<script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
<script src="/reports.js"></script>
<script>
    const R = <%- JSON.stringify(R.field) %>;
    chPie('c_prog', R.byProgram);
    chBar('c_country', R.byCountry, false, '#23c69a');
    chLine('c_time', R.overTime);
</script>
</body></html>
