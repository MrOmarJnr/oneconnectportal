uploads/*
!uploads/.gitkeep

# ===== Logs =====
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
logs/
pids/
*.pid
*.seed

# ===== OS / editor cruft =====
.DS_Store
Thumbs.db
Desktop.ini
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Build / cache / coverage =====
dist/
build/
coverage/
.cache/
