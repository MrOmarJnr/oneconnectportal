# =============================================================================
# One Connect Portal — environment variables
# Copy to `.env` for LOCAL development. In PRODUCTION set these in the Vercel
# dashboard for the PORTAL project (Settings → Environment Variables) — never
# commit real values. See ../DEPLOY.md for the full walkthrough.
# =============================================================================

# ---- Email (Resend) --------------------------------------------------------
# API key from https://resend.com (Account → API Keys).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# Sender must use a DOMAIN VERIFIED IN RESEND. Friendly-name form is fine:
MAIL_FROM=United in One Global Foundation <noreply@yourverifieddomain.org>
# Where admin alert emails go (comma/semicolon-separated for multiple).
# NOTE: this is ALSO the login email of the admin account created on first run.
ADMIN_EMAIL=info@unitedinone.org

# ---- File + record storage (Vercel Blob) -----------------------------------
# Auto-added by Vercel when you connect a PRIVATE Blob store to the project.
# Leave BLANK locally to fall back to the local filesystem (./uploads + ./data).
BLOB_READ_WRITE_TOKEN=

# ---- Admin portal ----------------------------------------------------------
# Long random string used to sign the session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# First-run admin account, created automatically the first time the DB is empty.
# Login is ADMIN_EMAIL (above) + ADMIN_PASSWORD. Change the password after login.
ADMIN_NAME=Admin
ADMIN_PASSWORD=ChangeMe123!

# Public URL of the PORTAL — used in portal account/password-reset emails.
# On Vercel set this to the portal's domain, e.g. https://portal.unitedinone.org
PORTAL_URL=http://localhost:3000

# Set to "production" on Vercel so session cookies are marked Secure.
NODE_ENV=development

# Origins allowed to POST to /api/submit/* (CORS). With the recommended proxy
# rewrite you don't need this (requests arrive same-origin via the website).
# Only set it if the website posts to the portal's absolute URL instead:
# ALLOWED_ORIGINS=https://unitedinone.org,https://www.unitedinone.org
ALLOWED_ORIGINS=

# Local dev port (ignored on Vercel).
PORT=3000
