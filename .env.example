# Copy this file to .env and fill in real values before running in production.

# Port the server listens on
PORT=3000

# Used to sign session cookies — set this to a long random string in production
SESSION_SECRET=change-this-to-a-long-random-string

# Default admin account, created automatically the FIRST time the server runs
# (only if the admins table is empty). Change the password after first login,
# or use `node scripts/set-admin-password.js` to update/create accounts later.
ADMIN_NAME=Admin
ADMIN_EMAIL=admin@unitedinone.org
ADMIN_PASSWORD=ChangeMe123!

# Set to "production" when deploying behind HTTPS so session cookies are
# marked secure.
NODE_ENV=development

# Comma-separated list of origins allowed to POST to /api/submit/* (CORS).
# Leave blank while testing locally — every origin is allowed by default.
# Once your site is live, lock this down, e.g.:
# ALLOWED_ORIGINS=https://unitedinone.org,https://www.unitedinone.org
ALLOWED_ORIGINS=

# ---- Email (Resend) for account + reset emails ----
RESEND_API_KEY=
MAIL_FROM=One Connect Portal <noreply@unitedinone.org>
PORTAL_URL=https://portal.unitedinone.org
